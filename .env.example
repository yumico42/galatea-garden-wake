# Garden Wake Bridge (required)
GARDEN_MACHINE_TOKEN=replace-with-garden-machine-token
GARDEN_BASE_URL=https://wake-v1.abysslumina.com
GARDEN_LOG_LEVEL=info

# Safety latch (the Zeabur service must mount a persistent Volume at /data)
GARDEN_STATE_DIRECTORY=/data/garden-wake
GARDEN_REQUIRE_PERSISTENT_STATE=true

# Existing MCP Gateway private endpoint (required)
GATEWAY_WAKE_URL=http://replace-with-private-host.zeabur.internal:10000/internal/garden/wake
GATEWAY_WAKE_SECRET=replace-with-a-long-random-secret
GATEWAY_WAKE_TIMEOUT_MS=10000

# Only set true for another explicitly trusted private network.
GATEWAY_ALLOW_INSECURE_HTTP=false
